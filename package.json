{
  "name": "indie-ads",
  "version": "0.6.20",
  "license": "MIT",
  "homepage": "https://indieadnetwork.com",
  "keywords": ["ads", "cross-promotion", "indie-games", "gamedev", "rewarded-ads", "interstitial", "playable-ads", "mraid", "capacitor"],
  "description": "The open-source SDK for Indie Ad Network: cross-promotion for indie games. Rewarded and interstitial ads (15/30 s videos and MRAID playables) swapped between indie games, one impression for one. No dependencies.",
  "type": "module",
  "private": true,
  "exports": { ".": "./core/index.js", "./core/*": "./core/*" },
  "files": ["core", "schema"],
  "scripts": {
    "test": "node --test",
    "validate": "node tools/validate-catalogue.mjs",
    "build:player": "node tools/build-player.mjs",
    "preview": "python3 -m http.server 8765 --bind 127.0.0.1"
  }
}
